#include <bits/stdc++.h>
using namespace std;
int find(vector<int>& led,int node){
	if(led[node]!=node){
		led[node]=find(led,led[node]);
	}
	return led[node];
}
void join(vector<int>& led,int a,int b){
	int leda=find(led,a);
	int ledb=find(led,b);
	led[ledb]=leda;
}
int main(){
	int n,m;
	cin>>n;
	vector<int> led(n+1);
	for(int i=1;i<=n;i++){
		led[i]=i;
	}
	cin>>m;
	for(int i=0;i<m;i++){
		int a,b;
		cin>>a>>b;
		join(led,a,b);
	}
	set<int> s;
	for(int i=1;i<=n;i++){
		s.insert(find(led,i));
	}
	cout<<s.size()<<endl;
	return 0;
}
